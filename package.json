{
	"name": "vite-react-locator",
	"version": "1.1.1",
	"description": "Instantly jump from your browser to the exact source location of any JSX element.",
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"lint": "eslint .",
		"test": "vitest"
	},
	"keywords": [
		"vite",
		"vite-plugin",
		"react",
		"jsx",
		"locator",
		"component",
		"source",
		"editor",
		"vscode",
		"typescript",
		"developer-tools"
	],
	"author": {
		"name": "Shivam Singh",
		"url": "https://github.com/shivmSingh1"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shivmSingh1/vite-react-locator.git"
	},
	"bugs": {
		"url": "https://github.com/shivmSingh1/vite-react-locator/issues"
	},
	"homepage": "https://github.com/shivmSingh1/vite-react-locator#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"vite": "^6.0.0 || ^7.0.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		}
	},
	"devDependencies": {
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^24.3.0",
		"tsup": "^8.5.0",
		"typescript": "^5.9.2",
		"vite": "^7.3.6",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@babel/generator": "^7.29.7",
		"@babel/parser": "^7.29.7",
		"@babel/traverse": "^7.29.7",
		"@babel/types": "^7.29.7",
		"magic-string": "^1.1.0"
	}
}